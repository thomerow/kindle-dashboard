# systemd unit of the Kindle dashboard server, installed by deploy.sh as /etc/systemd/system/<service>.service.
# deploy.sh replaces @NAME@, @PORT@ and @PATHBASE@.
# Author: Thorsten Kummerow <thorsten.kummerow (at) gmail (dot) com>

[Unit]
Description=Kindle dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@NAME@
Group=@NAME@
WorkingDirectory=/opt/@NAME@
ExecStart=/opt/@NAME@/Dashboard

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Environment=Urls=http://127.0.0.1:@PORT@
Environment=PathBase=@PATHBASE@
# Where the power button is when the Kindle hangs in landscape: ButtonRight or ButtonLeft
Environment=Orientation=ButtonRight

# Creates /var/lib/@NAME@ with the right owner: database, password hash, device token, cookie keys
StateDirectory=@NAME@
StateDirectoryMode=0700

Restart=always
RestartSec=5
# ASP.NET Core shuts down cleanly on SIGINT; the server ends open long polls of the Kindle then
KillSignal=SIGINT
TimeoutStopSec=15

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
